/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 28rpx;
  color: #1D2129;
  background-color: #F0F4F8;
  --color-primary: #1976D2;
  --color-success: #4CAF50;
  --color-warning: #FF9800;
  --color-error: #F44336;
  --color-temp: #FF7043;
  --color-humidity: #42A5F5;
  --color-led-on: #4CAF50;
  --color-led-off: #BDBDBD;
  --color-bg-page: #F0F4F8;
  --color-bg-card: #FFFFFF;
  --color-text-primary: #1D2129;
  --color-text-secondary: #4E5969;
  --color-text-tertiary: #86909C;
  --color-border: #E0E4E8;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-button: 48rpx;
  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
}