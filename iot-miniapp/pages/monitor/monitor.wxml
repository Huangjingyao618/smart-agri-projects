<!-- 数据监控页 -->
<view class="page-container">
  <!-- 连接状态栏 -->
  <view class="status-bar">
    <view class="status-dot {{connectStatus}}"></view>
    <text class="status-text">{{statusText}}</text>
    <text class="reconnect-btn" wx:if="{{connectStatus !== 'connected' && connectStatus !== 'connecting'}}" bindtap="handleReconnect">重连</text>
  </view>

  <!-- 温湿度卡片 -->
  <view class="data-cards">
    <view class="data-card temp-card">
      <text class="card-icon">🌡️</text>
      <text class="card-label">温度</text>
      <text class="card-value">{{deviceData.temp}}<text class="card-unit">℃</text></text>
    </view>
    <view class="data-card humi-card">
      <text class="card-icon">💧</text>
      <text class="card-label">湿度</text>
      <text class="card-value">{{deviceData.humidity}}<text class="card-unit">%</text></text>
    </view>
  </view>

  <!-- LED 状态速览 -->
  <view class="led-overview">
    <text class="section-title">LED 状态</text>
    <view class="led-row">
      <text class="led-label">LED1</text>
      <text class="led-badge {{deviceData.LED1 ? 'on' : 'off'}}">{{deviceData.LED1 ? '已开启' : '已关闭'}}</text>
    </view>
    <view class="led-row">
      <text class="led-label">LED2</text>
      <text class="led-badge {{deviceData.LED2 ? 'on' : 'off'}}">{{deviceData.LED2 ? '已开启' : '已关闭'}}</text>
    </view>
  </view>

  <!-- 更新时间 -->
  <text wx:if="{{deviceData.timestamp > 0}}" class="update-time">
    更新时间：{{updateTime}}
  </text>
</view>