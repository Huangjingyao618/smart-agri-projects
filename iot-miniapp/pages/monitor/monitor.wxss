/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E3F2FD 0%, var(--color-bg-page) 30%);
  padding: var(--spacing-lg);
  box-sizing: border-box;
}

/* 连接状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-lg);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-card);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: var(--spacing-sm);
}

.status-dot.connected {
  background: var(--color-success);
}

.status-dot.connecting {
  background: var(--color-warning);
  animation: pulse 1.5s ease-in-out infinite;
}

.status-dot.disconnected,
.status-dot.error {
  background: var(--color-error);
}

.status-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.reconnect-btn {
  margin-left: auto;
  padding: 8rpx 24rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 22rpx;
}

/* 数据卡片 */
.data-cards {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
  gap: var(--spacing-md);
}

.data-card {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.card-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: var(--spacing-sm);
}

.card-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.card-value {
  font-size: 64rpx;
  font-weight: 700;
}

.temp-card .card-value {
  color: var(--color-temp);
}

.humi-card .card-value {
  color: var(--color-humidity);
}

.card-unit {
  font-size: 28rpx;
  font-weight: 400;
  margin-left: 4rpx;
}

/* LED 速览 */
.led-overview {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-md);
}

.led-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
}

.led-row:not(:last-child) {
  border-bottom: 1rpx solid #F2F3F5;
}

.led-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.led-badge {
  padding: 6rpx 24rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #FFFFFF;
}

.led-badge.on {
  background: var(--color-led-on);
}

.led-badge.off {
  background: var(--color-led-off);
}

/* 更新时间 */
.update-time {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-md);
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}